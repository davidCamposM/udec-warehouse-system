# Configuración real (credenciales). Solo se versiona config.example.php
/config/config.php
.env

# Documentación de trabajo (modelo de datos, diagramas): queda fuera del repositorio
/docs/

# Datos generados por el servidor: logs, sesiones y respaldos. Se conservan las carpetas
/storage/**
!/storage/**/
!/storage/**/.gitkeep
!/storage/.htaccess

# Solo desarrollo: el repositorio lleva únicamente lo que necesita el servidor (Apache + PHP + MySQL).
# Quedan en el computador de desarrollo: dependencias, herramientas, pruebas (PHPUnit y E2E) y el entorno Docker.
/vendor/
/node_modules/
/tools/
/tests/
/e2e/
/phpunit.xml.dist
/docker/
/docker-compose.yml
/.env.example
/.editorconfig
# Reinicia la base de pruebas (borra todas las tablas): solo la usan tests/ y e2e/, nunca el servidor
/app/Support/BaseDePruebas.php

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# Editores
.vscode/
.idea/
*.swp
~$*
.~lock.*
