# Solo actúa si el document root del servidor apunta a la raíz del proyecto en vez de a public/.
# Envía internamente toda petición a public/, así nada fuera de public/ queda expuesto.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Aunque no haya mod_rewrite, los archivos de la raíz (documentación, Docker, archivos ocultos)
# no se sirven.
<FilesMatch "^(\..+|README\.md|docker-compose\.yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
